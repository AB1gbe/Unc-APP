# Copy this file to ".env" (same folder) and fill in what you need.
# The server reads it automatically on `npm run dev`, `npm start`, `npm run seed`.
# .env is git-ignored: never commit real passwords or keys.

# ---- General ----
# NODE_ENV=production
# PORT=4000
# DATA_DIR=./data
# SECRET_PEPPER=paste-a-long-random-string-here
# ADMIN_EMAIL=you@yourdomain.com
# ADMIN_PASSWORD=a-strong-password

# Public address of the website - used for links inside emails.
# Development with `npm run dev`: http://localhost:5173
APP_URL=http://localhost:5173

# ---- Email ----
# console = print emails in the terminal (default, development only)
# smtp    = any SMTP provider (Gmail, Resend, Brevo, Postmark, Mailgun, SES...)
# resend  = Resend HTTP API
MAIL_TRANSPORT=console
MAIL_FROM=Unc <no-reply@yourdomain.com>

# Testing with your personal Gmail (needs an App Password: https://myaccount.google.com/apppasswords)
# MAIL_TRANSPORT=smtp
# MAIL_FROM=Unc <your.address@gmail.com>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your.address@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# Then check it with:  npm run mail:test -- your.address@gmail.com

# SMTP settings for other providers (MAIL_TRANSPORT=smtp)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=resend
# SMTP_PASS=your-api-key-or-password

# Resend HTTP API (MAIL_TRANSPORT=resend)
# RESEND_API_KEY=re_xxxxxxxx
